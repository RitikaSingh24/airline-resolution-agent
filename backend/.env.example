DATABASE_URL=sqlite:///./data/airline_resolution.db

# LangChain / LLM provider configuration — set real keys in backend/.env (never commit that file)

# Example for OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key
# LLM_MODEL=gpt-4o-mini

# Example for Gemini:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-1.5-flash

# Example for Groq:
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key
# LLM_MODEL=llama-3.3-70b-versatile

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

CORS_ORIGINS=http://localhost:3000
